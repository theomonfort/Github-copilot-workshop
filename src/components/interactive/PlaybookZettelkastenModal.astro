---
import type { CategoryId } from '../../lib/playbook-categories';
import '../../vendor/zettelkasten/zettelkasten.css';

interface Props {
  slug: string;
  category: CategoryId;
}

const { slug, category } = Astro.props;
---

<button
  type="button"
  class="present-zk-btn"
  data-zk-trigger
  data-playbook-slug={slug}
  data-playbook-category={category}
  aria-haspopup="dialog"
  aria-controls="playbook-zettelkasten"
  aria-label="Zettelkasten ナレッジグラフを開く (Z)"
>
  <span aria-hidden="true">[Z]</span> Zettelkasten
  <span class="zk-trigger-topic" data-zk-topic>{slug}</span>
</button>

<dialog id="playbook-zettelkasten" class="zk-modal-overlay" aria-label="Zettelkasten ナレッジグラフ">
  <header class="zk-modal-topbar">
    <p><strong>ZETTELKASTEN</strong> <span data-zk-current aria-live="polite"></span></p>
    <button type="button" data-zk-close autofocus>Esc スライドに戻る</button>
  </header>
  <div class="zk-modal-body">
    <p class="zk-modal-loading" role="status" data-zk-loading>Zettelkasten を読み込み中…</p>
    <div class="zk-modal-stage" data-zk-stage></div>
  </div>
</dialog>

<script>
  import '../../scripts/zettelkasten';
</script>

<style is:global>
  .present-zk-btn {
    display: none;
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 310;
    max-width: min(36rem, 55vw);
    padding: .5rem .75rem;
    border: 1px solid #00f0ff;
    background: #0a0e27;
    color: #00f0ff;
    font: 1rem 'DotGothic16', monospace;
    text-align: left;
  }
  body.present-mode .present-zk-btn { display: flex; align-items: center; gap: .5rem; }
  .zk-trigger-topic { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #e8f4ff; }
  .zk-modal-overlay {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 2px solid #00f0ff;
    background: #05060f;
    color: #e8f4ff;
    font-family: 'DotGothic16', monospace;
  }
  .zk-modal-overlay[open] { display: flex; flex-direction: column; }
  .zk-modal-overlay:not([open]) { display: none; }
  .zk-modal-overlay::backdrop { background: #05060f; }
  .zk-modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .65rem 1rem;
    border-bottom: 1px dashed #00f0ff;
    background: #0a0e27;
  }
  .zk-modal-topbar p { margin: 0; min-width: 0; }
  body.present-mode .playbook-detail .zk-modal-topbar { margin: 0; }
  .zk-modal-topbar strong { color: #00f0ff; }
  .zk-modal-topbar [data-zk-current] { margin-left: .75rem; }
  .zk-modal-topbar button {
    flex-shrink: 0;
    padding: .35rem .65rem;
    border: 1px solid #ffb000;
    background: #05060f;
    color: #ffb000;
    font: inherit;
  }
  .zk-modal-body { position: relative; flex: 1; min-height: 0; }
  .zk-modal-stage { width: 100%; height: 100%; }
  .zk-modal-overlay .zk-root { --zk-font-prose: 'DotGothic16', monospace; }
  .zk-modal-loading {
    position: absolute;
    inset: 1rem;
    z-index: 40;
    margin: 0;
    padding: 1rem;
    background: #0a0e27;
    border: 1px dashed #00f0ff;
  }
  body.akq-zk-open { overflow: hidden; }
  .present-zk-btn:focus-visible,
  .zk-modal-overlay button:focus-visible { outline: 2px solid #ffb000; outline-offset: 3px; }
  @media (max-width: 767px) {
    .zk-modal-topbar { font-size: .8rem; }
    .zk-modal-topbar [data-zk-current] { display: block; margin-left: 0; }
  }
</style>
